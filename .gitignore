# macOS
.DS_Store

# Sauvegardes créées par les outils (galerie, back office…)
*.bak

# Dépendances Node (au cas où)
node_modules/

# Dossier publié : reconstruit par Netlify à chaque envoi (voir netlify.toml).
public/

# Copies de sécurité manuelles (ancien design, anciennes versions)
*.avant-*
*.avant-redesign.css

# Devis et documents commerciaux (privés, jamais publiés)
devis/
